              "had not happened"
            ],
            [
              "wouldn't have adopted",
              "would not have adopted"
            ]
          ],
          "hint": "not happen / not adopt",
          "hintAfterError": "Third Conditional: had + particípio na oração com 'If'; would have + particípio na outra."
        },
        {
          "prompt": "If we ___ the old policy, we ___ talent.",
